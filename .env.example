# ⚠️ CONFIGURAR ANTES DE DEPLOY

# 1. URL del Backend (REQUERIDO)
BACKEND_URL=https://tu-api-produccion.com/api

# 2. AWS S3 Configuration
BUCKET_NAME=eshop-fe
AWS_REGION=us-east-1

# 3. Build Configuration
BUILD_OUTPUT=dist/erp-fe-sakai/browser

# ========================================
# INSTRUCCIONES
# ========================================

# 1. Copiar este archivo a .env (opcional)
# 2. Actualizar BACKEND_URL con tu URL real
# 3. Actualizar src/environments/environment.prod.ts
# 4. Ejecutar: .\setup-s3-bucket.ps1 (solo 1 vez)
# 5. Ejecutar: npm run deploy
